# Copy to .env and fill in. .env is gitignored.

# Which host serves Dex's model: baseten (Muse Spark Open, default) | meta | fireworks
DEX_PROVIDER=baseten
# Optional override of the provider's default model id
# (meta: muse-spark-1.3, baseten: meta-models/muse-spark-open-1026, fireworks: required)
DEX_MODEL=

# Baseten key for Muse Spark Open
BASETEN_API_KEY=
# Meta Model API key (https://dev.meta.ai): always needed, for Muse Voice
# Transcribe and SAM 3.1, and for Muse Spark 1.3 when DEX_PROVIDER=meta
MODEL_API_KEY=
FIREWORKS_API_KEY=

# Balance Desk link (optional): where approved splits are saved.
# The token is Balance Desk's DEX_LINK_TOKEN.
BALANCE_DESK_URL=
BALANCE_DESK_TOKEN=
