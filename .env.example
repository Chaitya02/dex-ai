# Copy to .env and fill in. .env is gitignored.

# Which host serves Dex's model: meta | baseten | fireworks
DEX_PROVIDER=meta
# Optional override of the provider's default model id
# (meta: muse-spark-1.3, baseten: meta-models/muse-spark-open-1026, fireworks: required)
DEX_MODEL=

# Meta Model API key (https://dev.meta.ai)
MODEL_API_KEY=
# Only needed if you switch DEX_PROVIDER
BASETEN_API_KEY=
FIREWORKS_API_KEY=
